@echo off
setlocal EnableExtensions

REM =============================================================================
REM  LangTechDepot installer for Windows - double-click this file.
REM
REM  This one .bat file carries the entire PowerShell installer as plain text
REM  below the marker line further down this file. Windows won't run a
REM  downloaded .ps1 just by right-clicking it, so at run time this batch
REM  file extracts everything after that marker into a temporary .ps1 file
REM  and runs it the one way that works without changing any machine-wide
REM  setting - so a field user still only has ONE file to download and
REM  double-click, with no second file to keep alongside it.
REM
REM  CMD reads this file line by line and stops the instant it hits
REM  "exit /b" below, so everything after the marker - including all the
REM  PowerShell syntax - is never seen or parsed by CMD at all. Only
REM  PowerShell ever reads that part, via the one-liner just below. That
REM  one-liner deliberately avoids "|", "<", ">" and "&" since CMD treats
REM  those as its own pipe/redirection characters even inside quotes.
REM =============================================================================

set "PAYLOAD=%TEMP%\langtechdepot-setup-%RANDOM%.ps1"
set "HELP_URL=https://depot.langtech.cloud/help.html"

REM The two paths reach PowerShell through environment variables, never
REM spliced into the -Command text: a path with an apostrophe in it (a user
REM called O'Brien, whose %TEMP% is C:\Users\O'Brien\...) would end a quoted
REM PowerShell string early and break the command. $env:... is read as data.
REM The payload is written as UTF-8 with a byte-order mark, which Windows
REM PowerShell needs to read anything non-ASCII in a .ps1 correctly.
REM Exit code 3 means Group Policy enforces an execution policy that
REM -ExecutionPolicy Bypass cannot override (see :policy below).
set "LTD_SELF=%~f0"
set "LTD_PAYLOAD=%PAYLOAD%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$m='#--LANGTECHDEPOT-PS1-PAYLOAD-BELOW--#';$l=[System.IO.File]::ReadAllLines($env:LTD_SELF);$i=-1;for($j=0;$j -lt $l.Length;$j++){if($l[$j] -eq $m){$i=$j+1;break}};if($i -lt 0){Write-Error 'Could not find the embedded installer inside this file.';exit 1};[System.IO.File]::WriteAllLines($env:LTD_PAYLOAD,$l[$i..($l.Length-1)],[System.Text.Encoding]::UTF8);foreach($h in 'HKEY_LOCAL_MACHINE','HKEY_CURRENT_USER'){$k=$h+'\SOFTWARE\Policies\Microsoft\Windows\PowerShell';$p=[string][Microsoft.Win32.Registry]::GetValue($k,'ExecutionPolicy',$null);$en=[Microsoft.Win32.Registry]::GetValue($k,'EnableScripts',$null);if((@('AllSigned','Restricted') -contains $p) -or ($en -eq 0)){exit 3}}"
if "%ERRORLEVEL%"=="3" goto policy

if not exist "%PAYLOAD%" (
    echo Something went wrong extracting the installer from this file.
    echo Please try downloading it again. If that does not help, see:
    echo     %HELP_URL%
    echo.
    pause
    exit /b 1
)

REM -From tells the installer which folder this .bat is in, so it can find a
REM syncthing.exe put beside it by hand. %~dp0 ends in a backslash, and a
REM backslash right before the closing quote would escape the quote itself;
REM the trailing "." names the same folder without that problem.
REM -Self is this .bat file: the installer copies it beside syncthing.exe as
REM modify-langtechdepot.bat. -InvokedAs is the name it was started by, so
REM the installer knows which of the two it is.
REM %* passes on whatever was typed after the name, unchanged - e.g.
REM "modify-langtechdepot add Android_apps" - for command-line mode.
powershell -NoProfile -ExecutionPolicy Bypass -File "%PAYLOAD%" -NoPause -From "%~dp0." -Self "%~f0" -InvokedAs "%~n0" %*

REM Stashed before pause and before del, either of which could reset
REM ERRORLEVEL, so an unattended caller still sees whether the install
REM actually worked.
set RC=%ERRORLEVEL%
del "%PAYLOAD%" >nul 2>&1
REM No pause when arguments were given: whoever typed them is already at a
REM Command Prompt, and the window stays open anyway. Double-clicked, or
REM run with no arguments, the window must wait to be read.
if "%~1"=="" (
    echo.
    pause
)
exit /b %RC%

:policy
REM Group Policy (set by whoever manages this computer) requires signed
REM PowerShell scripts, and that overrides -ExecutionPolicy Bypass. Nothing
REM this file can do gets round it, so say so plainly rather than leave the
REM user with PowerShell's own error.
del "%PAYLOAD%" >nul 2>&1
echo.
echo This computer's settings, chosen by whoever manages it, do not allow
echo the LangTechDepot installer to run. Please show this message to your
echo IT support, or see:
echo     %HELP_URL%
echo.
pause
exit /b 1

#--LANGTECHDEPOT-PS1-PAYLOAD-BELOW--#
