# Copy to /etc/caddy/Caddyfile. Caddy obtains and renews the Let's Encrypt
# certificate on its own, which is the whole reason to use it here.
#
#   sudo apt install caddy
#   sudo systemctl reload caddy
#
# Requires port 80 and 443 open to this host and the name below pointed at it.

depot.langtech.cloud {
    encode gzip

    log {
	output file /var/log/caddy/langtechdepot.log
    }

    # 1. Route the "/files" path to our software download tree
    handle_path /files* {
	root * /data/LT/Groups
    	file_server browse
    }

    # 2. Route absolutely everything else to our register.py script
    handle {
	# The registration service binds to localhost only; Caddy is its TLS front.
	reverse_proxy localhost:8385
    }
}

# --- Bringing the instructions site here -------------------------------------
#
# Today the instructions site (docs/ in this repo) is published by GitHub
# Pages and this host serves only the form. The two are written to merge: the
# site's internal links are all relative, and the one absolute URL it needs -
# the curl command on the Linux page - rewrites itself from window.location.
#
# When you are ready, publish the built site (the _site tree that
# .github/workflows/pages.yml assembles, or docs/ plus a downloads/ folder) to
# /srv/langtechdepot-site on this box and swap block 2 above for:
#
#     # The form keeps an address of its own once the site owns "/";
#     # register.py serves it at both / and /signup.
#     handle /signup* {
#         reverse_proxy localhost:8385
#     }
#     handle /register* {
#         reverse_proxy localhost:8385
#     }
#     handle /request* {
#         reverse_proxy localhost:8385
#     }
#     handle /healthz* {
#         reverse_proxy localhost:8385
#     }
#     handle {
#         root * /srv/langtechdepot-site
#         file_server
#     }
#
# Then set SITE_URL=https://depot.langtech.cloud in register.env, restart the
# service, and in docs/assets/site.js set DEPOT to '' and SIGNUP to '/signup'
# so the site's links to the form become same-origin and stop colliding with
# the site's own front page. Point GitHub Pages at this hostname or leave it
# running as a mirror; both sites keep working either way.
