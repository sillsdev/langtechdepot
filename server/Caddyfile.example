# Copy to /etc/caddy/Caddyfile. Caddy obtains and renews the Let's Encrypt
# certificate on its own, which is the whole reason to use it here.
#
#   sudo apt install caddy
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Requires port 80 and 443 open to this host and the name below pointed at it.
#
# depot.langtech.cloud is the one address field users are given. "/" is the
# instructions site and the form is at /signup, so the whole journey - read,
# get a token, download, come back for help - stays on this one name.

depot.langtech.cloud {
    encode gzip

    log {
	output file /var/log/caddy/langtechdepot.log
    }

    # 1. Route the "/files" path to our software download tree.
    #    "/files/*", not "/files*": the latter also matches /filesX. The bare
    #    /files gets a redirect so relative links in the listing resolve.
    redir /files /files/
    handle_path /files/* {
        root * /data/LT/Groups
        file_server browse {
            # Dotfiles (Syncthing's .stfolder, .stversions, ...) are not for
            # browsing.
            hide .*
        }
    }

    # 2. The form used to live at "/", and links to it carried ?os=. Send any
    #    still in circulation to its address now.
    @oldform {
        path /
        query os=*
    }
    redir @oldform /signup?{query} 302

    # 3. The registration service. These are the only paths it answers, so
    #    match them exactly. It binds to 127.0.0.1 only (IPv4, so not
    #    "localhost", which may resolve to ::1 first); Caddy is its TLS front.
    #    Its biggest legitimate body is a short form; register.py refuses
    #    anything over 64 000 bytes itself, this stops it at the door.
    @app path /signup /register /request /healthz
    handle @app {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8385
    }

    # 4. Everything else is the instructions site, mirrored from GitHub Pages.
    #    CI keeps publishing there (.github/workflows/pages.yml), so nothing is
    #    deployed to this box for it, and sillsdev.github.io/langtechdepot stays
    #    up as a second copy - installers from before the switch link to it.
    #    Host is named outright: Pages picks the site by it, and this way it
    #    does not depend on the Caddy version or carry a port.
    handle {
        rewrite * /langtechdepot{uri}
        reverse_proxy https://sillsdev.github.io {
            header_up Host sillsdev.github.io
        }
    }
}

# --- If GitHub has to come out of the request path ---------------------------
#
# Block 4 makes every page view a fetch from GitHub Pages. Should that ever be
# unwanted, copy the built site (the _site tree that
# .github/workflows/pages.yml assembles: docs/ plus downloads/) to
# /srv/langtechdepot-site on this box and swap block 4 for:
#
#     handle {
#         root * /srv/langtechdepot-site
#         file_server
#     }
#
# Nothing in the site or register.py changes: the site's links are relative,
# and the Linux curl command rewrites itself from window.location.
