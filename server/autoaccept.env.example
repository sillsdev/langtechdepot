# Copy to /etc/langtran/autoaccept.env and chmod 600 (contains the API key).
SYNCTHING_URL=http://127.0.0.1:8384
# Either set the key directly...
SYNCTHING_API_KEY=
# ...or point at the Syncthing config to read it from <gui><apikey>.
#SYNCTHING_CONFIG=/home/syncthing/.local/state/syncthing/config.xml

# Devices must announce themselves named LT-<token>-<anything> to be accepted.
JOIN_TOKEN=change-me

# Optional: restrict which folders are offered. Default = every folder on the server.
#CATALOG_FOLDERS=software-core,software-extras,training-videos,docs
