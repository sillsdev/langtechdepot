[Unit]
Description=LangTechDepot registration service
After=network-online.target syncthing@syncthing.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/langtechdepot/register.env
ExecStart=/usr/bin/python3 /opt/langtechdepot-sync/register.py
Restart=on-failure
RestartSec=5

# Runs as the Syncthing owner so it can read config.xml for the API key.
User=syncthing
StateDirectory=langtechdepot

# Only ever talks to localhost Syncthing and outbound SMTP; nothing here
# needs to write outside its state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/langtechdepot

[Install]
WantedBy=multi-user.target
