[Unit]
Description=LangTran registration service
After=network-online.target syncthing@syncthing.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/langtran/register.env
ExecStart=/usr/bin/python3 /opt/langtran-sync/register.py
Restart=on-failure
RestartSec=5

# Runs as the Syncthing owner so it can read config.xml for the API key.
User=syncthing
StateDirectory=langtran

# Only ever talks to localhost Syncthing and outbound SMTP; nothing here
# needs to write outside its state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/langtran

[Install]
WantedBy=multi-user.target
