# Copy to /etc/langtechdepot/register.env, chgrp syncthing, chmod 640 (holds the API key
# and SMTP password; the service runs as syncthing and must be able to read it).

# --- Syncthing ---------------------------------------------------------------
SYNCTHING_URL=http://127.0.0.1:8384
# Either set the key directly...
SYNCTHING_API_KEY=""
# ...or point at the Syncthing config to read it from <gui><apikey>.
#SYNCTHING_CONFIG=/home/syncthing/.local/state/syncthing/config.xml

# Handed to clients at registration so they can dial in directly as well as
# via discovery. Must match the port you opened (22000).
SERVER_ADDRESS=tcp://depot.langtech.cloud:22000

# Optional: restrict which folders are offered. Default = every folder.
#CATALOG_FOLDERS=All_Contents_List,Android_apps,Win_everything_en

# --- Service -----------------------------------------------------------------
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8385
DB_PATH=/var/lib/langtechdepot/register.db
PUBLIC_URL=https://depot.langtech.cloud

# The instructions site (docs/ in this repo). This service owns step 1 of the
# journey and that site owns steps 2 to 4, so every page here links back to it.
# When the site is eventually served from this host, point this at it there -
# e.g. https://depot.langtech.cloud - and move the form to /signup.
SITE_URL=https://sillsdev.github.io/langtechdepot

# false = requests queue for `ltd-sync-admin approve <token>`; ADMIN_EMAIL gets
#         the exact command, and approving emails the token to the applicant.
# true  = the form issues a token on the spot (shown on the page and emailed).
# Keep false while clients use introducer mode: every approved device can reach
# every field machine. The guard in register.py undoes changes from anyone but
# this server, but a person checking first is what keeps strangers out.
# The instructions site's step 1 is worded for false; change it if you flip this.
AUTO_APPROVE=false

# The guard (see SETUP.md §6). enforce = cut off any device that changes a
# catalog folder and override; report = only log and mail what it would do.
# Deploy with report for a day, read the journal, then switch to enforce.
GUARD_MODE=report

# --- Mail (optional) ---------------------------------------------------------
# With AUTO_APPROVE=false mail is the only way a token reaches anyone, so this
# section is not optional. (With true the page shows it and mail is the copy.)
# Leave SMTP_HOST empty until SMTP_PASS is filled in: with a host and no
# password, every sign-up waits on a failing login before the page appears.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=depot@langtech.cloud
SMTP_PASS=
MAIL_FROM=depot@langtech.cloud
# Gets each request to approve, and the guard's reports. Read it.
ADMIN_EMAIL=depot@langtech.cloud
