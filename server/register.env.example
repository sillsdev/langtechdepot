# Copy to /etc/langtechdepot/register.env and chmod 600 (holds the API key and SMTP password).

# --- Syncthing ---------------------------------------------------------------
SYNCTHING_URL=http://127.0.0.1:8385
# Either set the key directly...
SYNCTHING_API_KEY=""
# ...or point at the Syncthing config to read it from <gui><apikey>.
#SYNCTHING_CONFIG=/home/syncthing/.local/state/syncthing/config.xml

# Handed to clients at registration so they can dial in directly as well as
# via discovery. Must match the port you opened (22000).
SERVER_ADDRESS=tcp://depot.langtech.cloud:22000

# Optional: restrict which folders are offered. Default = every folder.
#CATALOG_FOLDERS=software-core,software-extras,training-videos,docs

# --- Service -----------------------------------------------------------------
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8384
DB_PATH=/var/lib/langtechdepot/register.db
PUBLIC_URL=https://depot.langtech.cloud

# true  = form issues a token immediately (emailed, or shown if SMTP is unset)
# false = requests queue for `register.py admin approve <token>`
AUTO_APPROVE=true

# --- Mail (optional) ---------------------------------------------------------
# Without SMTP_HOST the token is displayed on the confirmation page instead of
# emailed. Set it if you want an address on file that actually receives mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=distribution@lingtransoft.info
# Notified whenever someone registers.
ADMIN_EMAIL=
